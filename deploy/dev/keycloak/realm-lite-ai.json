{
  "realm": "lite-ai", "enabled": true,
  "internationalizationEnabled": true, "supportedLocales": ["zh-CN"], "defaultLocale": "zh-CN",
  "organizationsEnabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "smtpServer": {
    "host": "mailpit", "port": "1025", "from": "noreply@lite-ai.dev", "fromDisplayName": "Lite AI",
    "ssl": "false", "starttls": "false", "auth": "false"
  },
  "roles": {
    "realm": [
      {"name": "platform-admin", "description": "平台管理员(跨企业特权 API;身份降两级=realm role)"},
      {"name": "enterprise-admin", "description": "企业管理员(本企业 owner 越权 + 邀请)"}
    ]
  },
  "clients": [{
    "clientId": "gateway", "publicClient": false, "secret": "dev-secret",
    "directAccessGrantsEnabled": true, "standardFlowEnabled": true, "redirectUris": ["*"],
    "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "organization"]
  }, {
    "clientId": "lite-ai-web", "publicClient": false, "secret": "dev-web-secret",
    "standardFlowEnabled": true, "directAccessGrantsEnabled": false,
    "redirectUris": ["http://localhost:8090/auth/callback"],
    "webOrigins": ["http://localhost:8090"],
    "attributes": {"post.logout.redirect.uris": "http://localhost:8090/*"},
    "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "organization"]
  }],
  "organizations": [{
    "name": "Demo", "alias": "ent-demo", "enabled": true,
    "redirectUrl": "",
    "domains": [{"name": "acme.test", "verified": true}],
    "attributes": {"display_name": ["Demo 企业"]}
  }],
  "users": [{
    "username": "alice", "enabled": true, "email": "alice@acme.test",
    "firstName": "Alice", "lastName": "Anderson",
    "emailVerified": true, "requiredActions": [],
    "credentials": [{"type": "password", "value": "alice", "temporary": false}],
    "realmRoles": ["enterprise-admin"]
  }]
}
